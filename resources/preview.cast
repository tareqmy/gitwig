[6.106741, "o", "                \u001b[19;104H \u001b[19;106H  \u001b[19;109H \u001b[20;2H                                                                                                            \u001b[21;2H                                                                                                            \u001b[22;2H \u001b[22;6H                          \u001b[22;33H     \u001b[22;109H \u001b[23;2H \u001b[23;6H       \u001b[23;14H              \u001b[23;101H \u001b[23;103H     \u001b[23;109H \u001b[24;2H                                                                                                            \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
