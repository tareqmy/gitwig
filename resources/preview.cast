[64.759848, "o", "49mA\u001b[13;88H\u001b[22m\u2502\u001b[14;23H\u2502\u001b[39;49m \u001b[2mHome    \u001b[22m\u001b[1m\u001b[1mImport / clone remote repository\u001b[14;86H\u001b[38;5;6;49mi\u001b[14;88H\u001b[22m\u2502\u001b[15;23H\u2502\u001b[39;49m \u001b[2mHome    \u001b[22m\u001b[1m\u001b[1mEdit selected repository details\u001b[22m                     \u001b[1m\u001b[38;5;6;49me\u001b[22m\u001b[39;49m \u001b[38;5;6;49m\u2502\u001b[16;23H\u2502\u001b[39;49m \u001b[2mHome    \u001b[22m\u001b[1m\u001b[1mDelete selected repository from config\u001b[22m               \u001b[1m\u001b[38;5;6;49mD\u001b[22m\u001b[39;49m \u001b[38;5;6;49m\u2502\u001b[17;23H\u2502\u001b[39;49m \u001b[2mHome    \u001b[22m\u001b[1m\u001b[1mEdit custom labels of selected repository\u001b[17;86H\u001b[38;5;6;49ml\u001b[17;88H\u001b[22m\u2502\u001b[18;23H\u2502\u001b[39;49m \u001b[2mHome    \u001b[22m\u001b[1m\u001b[1mOpen label picker to filter repositories by label\u001b[18;86H\u001b[38;5;6;49mL\u001b[18;88H\u001b[22m\u2502\u001b[19;23H\u2502\u001b[39;49m \u001b[2mHome    \u001b[22m\u001b[1m\u001b[1mEnter search query to filter repositories\u001b[22m            \u001b[1m\u001b[38;5;6;49mf\u001b[22m\u001b[39;49m \u001b[38;5;6;49m\u2502\u001b[20;23H\u2502\u001b[39;49m \u001b[2mHome    \u001b[22m\u001b[1m\u001b[1mOpen fuzzy Jump-to-Repo picker overlay\u001b[22m               \u001b[1m\u001b[38;5;6;49m/\u001b[22m\u001b[39;49m \u001b[38;5;6;49m\u2502\u001b[21;23H\u2502\u001b[39;49m \u001b[2mHome    \u001b[22m\u001b[1"]
